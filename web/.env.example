NEXT_PUBLIC_SANITY_PROJECT_ID=jh3pdn6m
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: long-lived Instagram Graph API token for @artistsiaaa (latest posts on the home page)
INSTAGRAM_ACCESS_TOKEN=

# Newsletter sign-up (Mailchimp). Server-only; never prefix with NEXT_PUBLIC_.
# API key looks like xxxxxxxx-us22 (the part after the dash is the data center). List ID: Audience > Settings > Audience name and defaults.
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# Member profile form: token with Editor rights on the dataset, used only to create unpublished member drafts. Server-only.
SANITY_API_WRITE_TOKEN=

# Call for leads sign-ups: URL of the Google Apps Script web app that stores them in the Google Sheet. Server-only.
CALL_FOR_LEADS_SCRIPT_URL=

# Cloudflare Turnstile spam check on the three public forms. Leave both empty to skip the check (local development).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

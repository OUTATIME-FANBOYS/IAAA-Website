  "cards": [
    {
      "dot": "cyan",
      "title": "One source of truth",
      "items": [
        "Every text, label, link and image comes from Sanity",
        "Only the site title has a built-in fallback"
      ]
    },
    {
      "dot": "emerald",
      "title": "Pages are data",
      "items": [
        "A Page document's slug is its URL",
        "New pages need no code; new section types add a component and a query field"
      ]
    },
    {
      "dot": "violet",
      "title": "Layers",
      "items": [
